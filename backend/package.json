{
  "name": "school-erp-backend",
  "version": "1.0.0",
  "description": "Backend API Server for School ERP",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "db:push": "prisma db push --accept-data-loss && prisma generate",
    "test": "node --import ts-node/register --test src/tests/fees.test.ts src/tests/transport_policies.test.ts src/tests/fees_razorpay.test.ts src/tests/final_acceptance.test.ts",
    "test:superadmin": "node --no-experimental-strip-types -r ts-node/register src/tests/superadmin_modules.test.ts",
    "test:attendance-report": "node --no-experimental-strip-types -r ts-node/register src/tests/attendance_report.test.ts",
    "test:exam-analysis": "node --no-experimental-strip-types -r ts-node/register src/tests/exam_analysis.test.ts",
    "test:teacher-dashboard": "node --no-experimental-strip-types -r ts-node/register src/tests/teacher_dashboard.test.ts",
    "test:exam-permissions": "node --no-experimental-strip-types -r ts-node/register src/tests/exam_permissions.test.ts",
    "test:student-dashboard": "node --no-experimental-strip-types -r ts-node/register src/tests/student_dashboard.test.ts",
    "test:fee-fixes": "node --no-experimental-strip-types -r ts-node/register src/tests/fee_fixes.test.ts",
    "test:fee-flow": "node --no-experimental-strip-types -r ts-node/register src/tests/fee_flow.test.ts",
    "test:admin-dashboard": "node --no-experimental-strip-types -r ts-node/register src/tests/admin_dashboard.test.ts",
    "test:teacher-features": "node --no-experimental-strip-types -r ts-node/register src/tests/teacher_features.test.ts",
    "test:cms": "node --no-experimental-strip-types -r ts-node/register src/tests/cms.test.ts",
    "test:billing-rules": "node --no-experimental-strip-types -r ts-node/register --test src/tests/billing_rules.test.ts",
    "test:notices": "node --no-experimental-strip-types -r ts-node/register src/tests/notices.test.ts",
    "test:db-retry": "node --no-experimental-strip-types -r ts-node/register src/tests/db_retry.test.ts",
    "test:public-error": "node --no-experimental-strip-types -r ts-node/register src/tests/public_error.test.ts",
    "test:transport-rules": "node --no-experimental-strip-types -r ts-node/register src/tests/transport_rules.test.ts",
    "test:staff-login-role": "node --no-experimental-strip-types -r ts-node/register src/tests/staff_login_role.test.ts",
    "test:exam-flow": "node --no-experimental-strip-types -r ts-node/register src/tests/exam_flow.test.ts",
    "test:exam-scope": "node --no-experimental-strip-types -r ts-node/register src/tests/exam_teacher_scope.test.ts",
    "test:end-transport": "node --no-experimental-strip-types -r ts-node/register src/tests/end_transport.test.ts",
    "test:password-reset": "node --no-experimental-strip-types -r ts-node/register src/tests/password_reset.test.ts",
    "test:timetable-conflicts": "node --no-experimental-strip-types -r ts-node/register src/tests/timetable_conflicts.test.ts",
    "test:transport-policies": "node --no-experimental-strip-types -r ts-node/register --test src/tests/transport_policies.test.ts",
    "test:final-acceptance": "node --no-experimental-strip-types -r ts-node/register --test src/tests/final_acceptance.test.ts",
    "test:super-admin": "node --no-experimental-strip-types -r ts-node/register src/tests/super_admin_limits.test.ts",
    "test:fees-razorpay": "node --no-experimental-strip-types -r ts-node/register --test src/tests/fees_razorpay.test.ts",
    "test:token-version": "node --no-experimental-strip-types -r ts-node/register src/tests/token_version.test.ts",
    "test:privacy": "node --no-experimental-strip-types -r ts-node/register src/tests/privacy.test.ts",
    "test:sibling-concession": "node --no-experimental-strip-types -r ts-node/register src/tests/sibling_concession.test.ts",
    "test:student-records": "node --no-experimental-strip-types -r ts-node/register src/tests/student_records.test.ts",
    "test:inventory": "node --no-experimental-strip-types -r ts-node/register src/tests/inventory.test.ts",
    "test:rollover": "node --no-experimental-strip-types -r ts-node/register src/tests/session_rollover.test.ts",
    "reset-password": "npx ts-node scripts/reset-password.ts",
    "restore-backup": "npx ts-node scripts/restore-backup.ts",
    "seed": "npx ts-node prisma/seed.ts",
    "seed:concessions": "npx ts-node src/utils/seedConcessions.ts"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.22.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "nodemon": "^3.1.0",
    "prisma": "^7.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
