{
  "name": "school-erp-backend",
  "version": "1.0.0",
  "description": "Backend API Server for School ERP",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "db:push": "prisma db push --accept-data-loss && prisma generate",
    "test": "node --import ts-node/register --test src/tests/fees.test.ts src/tests/transport_policies.test.ts src/tests/fees_razorpay.test.ts src/tests/final_acceptance.test.ts src/tests/family_payment.test.ts",
    "seed": "npx ts-node prisma/seed.ts",
    "seed:concessions": "npx ts-node src/utils/seedConcessions.ts"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.2",
    "nodemon": "^3.1.0",
    "prisma": "^7.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
