# Server configuration
PORT=5000

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Environment
NODE_ENV=development

# Database connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Web Push (free browser push notifications) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@school.edu.in

# Security (production)
# Sites allowed to call the API, comma-separated (the ERP's own address). Empty = any (dev only).
CORS_ORIGIN=
# Set to 1 when running behind a hosting proxy (Render, Railway, Nginx) so login limits see real visitor IPs.
TRUST_PROXY=
# Passwords for the first Super Admin / Admin created on an empty database (production).
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=

# ---- Forgot password: email + SMS codes ----
SCHOOL_NAME=RRS Intl School

# Email (staff/admin reset codes). EMAIL_PROVIDER: smtp | console (console = print in server log).
# Gmail: SMTP_PASS is an App Password (Google Account > Security > 2-Step Verification > App passwords).
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
MAIL_FROM="RRS Intl School <you@gmail.com>"

# SMS (student reset codes). SMS_PROVIDER: console | twilio | msg91 | fast2sms
SMS_PROVIDER=console
SMS_DEFAULT_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=

# Testing: while set, EVERY reset code goes here instead of the user's own email/phone.
# Clear both to send codes to real users.
OTP_TEST_EMAIL=
OTP_TEST_PHONE=
