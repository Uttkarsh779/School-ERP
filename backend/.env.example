# Server configuration
PORT=5000

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Environment
NODE_ENV=development

# Database connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Web Push (free browser push notifications) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@school.edu.in

# Security (production)
# Sites allowed to call the API, comma-separated (the ERP's own address). Empty = any (dev only).
CORS_ORIGIN=
# Set to 1 when running behind a hosting proxy (Render, Railway, Nginx) so login limits see real visitor IPs.
TRUST_PROXY=
# Passwords for the first Super Admin / Admin created on an empty database (production).
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
